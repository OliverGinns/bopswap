# Copy to .env.local (gitignored). Keys are only read server-side (app/api/chat/route.ts); never exposed to the client.

# Live BopBot provider: anthropic | groq. Default: groq if GROQ_API_KEY is set, otherwise anthropic if ANTHROPIC_API_KEY is set.
BOPBOT_PROVIDER=
# Free key from https://console.groq.com (free tier is rate-limited; on a 429 BopBot falls back to scripted)
GROQ_API_KEY=
# Default: openai/gpt-oss-120b
GROQ_MODEL=
ANTHROPIC_API_KEY=
# live | scripted | auto  (auto = live if a provider key is set, otherwise scripted)
BOPBOT_MODE=auto

# Supabase (optional: without these, uploads are saved in the browser's localStorage). SQL: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
