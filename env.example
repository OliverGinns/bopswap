# Copy to .env.local (gitignored). The key is only read server-side by app/api/chat/route.ts.
ANTHROPIC_API_KEY=
# live | scripted | auto  (auto = live if ANTHROPIC_API_KEY is set, otherwise scripted)
BOPBOT_MODE=auto

# Supabase (optional: without these, uploads are saved in the browser's localStorage). SQL: supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
